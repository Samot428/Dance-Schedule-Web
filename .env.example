# Django settings - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here-change-this-in-production

# Allowed hosts (comma-separated)
# For local development: localhost,127.0.0.1
# For production: yourdomain.com,.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Leave empty for SQLite (development)
# For production PostgreSQL, Render will provide this automatically
DATABASE_URL=

# Security Settings (Production only)
SECURE_SSL_REDIRECT=False
